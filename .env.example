# ==========================================================
# ROD ASSISTANT — CONFIGURACIÓN PRIVADA DEL BACKEND
# Copia este archivo como .env EN EL SERVIDOR. NO subas .env a GitHub.
# ==========================================================

APP_ENV=production
ROD_DEMO_FALLBACK=true
ROD_CORS_ORIGINS=https://nuevo-cv5.pages.dev,http://localhost:5173,http://127.0.0.1:5173
ROD_OUTPUT_DIR=outputs

# ----------------------------------------------------------
# FACTILIZA — DNI
# ----------------------------------------------------------
FACTILIZA_TOKEN=
FACTILIZA_ENDPOINT_DNI=https://api.factiliza.com/v1/dni/info/{dni}
FACTILIZA_TIMEOUT=25
FACTILIZA_REINTENTOS=3
FACTILIZA_DNI_PRUEBA=

# ----------------------------------------------------------
# SUNAT API — COMPROBANTES
# 4D ONPE: 1 -> 01 Factura, 2 -> 03 Boleta, 3 -> R1 RHE
# ----------------------------------------------------------
SUNAT_API_RUC_CONSULTANTE=
SUNAT_API_CLIENT_ID=
SUNAT_API_CLIENT_SECRET=
SUNAT_API_SCOPE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
SUNAT_TOKEN_URL=https://api-seguridad.sunat.gob.pe/v1/clientesextranet/{client_id}/oauth2/token/
SUNAT_CPE_URL=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes/{ruc_consultante}/validarcomprobante
SUNAT_API_DELAY=1.0
SUNAT_CPE_TIMEOUT=45
SUNAT_CPE_REINTENTOS=4
SUNAT_CPE_ESPERAS_REINTENTO=2,5,10,20
SUNAT_CPE_REINTENTAR_SIN_ESTADO=true
SUNAT_CPE_SEGUNDA_PASADA=true
SUNAT_CPE_ESPERA_SEGUNDA_PASADA=5
SUNAT_CPE_REINTENTOS_SEGUNDA_PASADA=2
SUNAT_CPE_RENOVAR_TOKEN_SEGUNDA_PASADA=true
SUNAT_CPE_FISICO_REINTENTAR_CON_MONTO=true
SUNAT_CPE_FALLBACK_INTENTOS=1
SUNAT_TOKEN_TIMEOUT=40
SUNAT_TOKEN_REINTENTOS=3
SUNAT_TOKEN_ESPERAS_REINTENTO=2,5,10

# ----------------------------------------------------------
# SUNAT WEB — RUC / DATOS / REPRESENTANTES
# Para servidor usar headless=true. Requiere Chrome/Chromium + Selenium.
# ----------------------------------------------------------
SUNAT_WEB_URL=https://e-consultaruc.sunat.gob.pe/cl-ti-itmrconsruc/jcrS00Alias
SUNAT_WEB_HEADLESS=true
SUNAT_WEB_ENABLED=true
CHROME_BINARY=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
SUNAT_WEB_DELAY=1.5
SUNAT_WEB_TIMEOUT=22
SUNAT_WEB_REINTENTOS=2
SUNAT_WEB_DATOS_ADICIONALES_DNI=true
SUNAT_WEB_DOC_PRUEBA=
SUNAT_REPRESENTANTES_REINTENTOS=3
SUNAT_REPRESENTANTES_TIMEOUT_SEG=25
SUNAT_REPRESENTANTES_ESPERA_TABLA_SEG=2.0

# ----------------------------------------------------------
# PODER JUDICIAL — ASISTIDO
# Usuario/clave pueden quedar precargados; si aparece captcha, se resuelve manualmente.
# ----------------------------------------------------------
PJ_USUARIO=
PJ_CLAVE=
PJ_URL=https://sap.pj.gob.pe/consulta-financiamiento-prohibido-web/autenticacion/login
PJ_DELAY=1.0
PJ_RESULT_TIMEOUT_SEG=121
PJ_ESPERA_LOTE_SEG=30
PJ_TAMANIO_LOTE=15
PJ_ESPERA_ESTABILIDAD_SEG=2.0
PJ_CERRAR_PESTANAS_FINALIZADAS=true
PJ_CERRAR_PESTANAS_NO_FINALIZADAS=false
PJ_AUTO_CLICK_BUSCAR=true
PJ_AUTO_CAPTURA=true
PJ_AUTO_INICIAR_TODO_AL_VALIDAR=true
PJ_LIMPIAR_PESTANAS=true
PJ_CAPTURAS_DIR=CAPTURAS_PJ
# Si PJ corre en una PC Windows aparte, coloca aquí la URL privada de ONE/ROD Bridge.
PJ_BRIDGE_URL=

# ----------------------------------------------------------
# REGLAS DE MATCH
# ----------------------------------------------------------
MATCH_MIN_SIMILITUD=0.82
MATCH_MIN_SIMILITUD_DNI=0.82
MATCH_MIN_SIMILITUD_RUC_OK=0.92
MATCH_MIN_SIMILITUD_RUC_REVISAR=0.84
SUNAT_REPRESENTANTES_INCLUIR_RUC10=false
PJ_INCLUIR_DNI_DERIVADO_RUC10=true
PJ_MODO_ADMIN_MEZCLAR_EXPEDIENTES=false
